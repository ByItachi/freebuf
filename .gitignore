# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env (never commit real keys; .env.example stays tracked)
.env
.env*.local
.env*.development
.env*.production
!.env.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# editor/agent leftovers
*.bak
*.tmp

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.data/

# agent tooling (not part of the app)
/.freebuff/
/graphrag/

# desktop build artifacts (Tauri)
/src-tauri/target/
/src-tauri/bin/
/src-tauri/gen/schemas/
/.tauri-stub/

