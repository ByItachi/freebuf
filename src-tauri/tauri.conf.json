{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manus",
  "version": "0.1.0",
  "identifier": "com.manus.desktop",
  "build": {
    "frontendDist": "../.tauri-stub"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Manus",
    "resources": [
      "bin/node/*",
      "bin/standalone/**/*",
      "../server/server.js"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
